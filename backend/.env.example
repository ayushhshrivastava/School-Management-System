# ====================================================================
# Kids World School ERP - Environment Configuration Blueprint
# ====================================================================

# Application Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Authentication & Session Secrets (Replace in Production)
JWT_SECRET=kids_world_school_super_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=kids_world_school_refresh_token_secret_key_change_in_production_2026
JWT_REFRESH_EXPIRES_IN=7d

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kids_world_school_erp?schema=public

# Logging Configuration
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=logs
